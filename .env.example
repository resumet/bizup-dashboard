NEXT_PUBLIC_SUPABASE_URL=
HR_APP_URL=https://bizup-dashboard.vercel.app
HR_INITIAL_ADMIN_EMAIL=
HR_INITIAL_ADMIN_NAME=
HR_INITIAL_ADMIN_START_DATE=
HR_ORGANIZATION_NAME=
# 로컬 Supabase 가상 데이터 생성 시에만 사용
HR_DEMO_PASSWORD=
# 매분 /api/hr/cron을 호출하는 스케줄러의 Bearer 인증값
CRON_SECRET=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# 플친소재 메이커 전용 모델. 비우면 gpt-4.1-mini를 사용합니다.
OPENAI_COPY_MODEL=
OPENAI_VISION_MODEL=
# yt-dlp가 PATH에 없을 때만 실행 파일의 절대 경로를 입력합니다.
YT_DLP_PATH=
# 선택 사항: 별도 워커가 있으면 설정합니다. Vercel은 미설정 시 Sandbox를 사용합니다.
YOUTUBE_DOWNLOAD_WORKER_URL=
YOUTUBE_DOWNLOAD_WORKER_TOKEN=
# 외부 강의 생성 페이지(/course-intake) 설정
COURSE_INTAKE_PASSWORD=
COURSE_INTAKE_SESSION_SECRET=
COURSE_INTAKE_WORKSPACE_ID=
COURSE_INTAKE_CREATED_BY_USER_ID=
SHOONG_API_KEY=
SHOONG_SENDER_KEY=
SHOONG_TEMPLATE_PAID_CONFIRM=
SHOONG_TEMPLATE_PAID_INVITE=
SHOONG_SEND_TYPE_PAID_CONFIRM=at
SHOONG_SEND_TYPE_PAID_INVITE=at
SHOONG_CALLBACK_NUMBER=
# 테스트/프록시를 사용할 때만 덮어씁니다. 기본값: https://api.shoong.kr/send
SHOONG_API_BASE_URL=

# 메시지 발송 공급자: shoong 또는 directalk
MESSAGE_PROVIDER=shoong
DIRECTALK_API_KEY=
DIRECTALK_CHANNEL_ID=
DIRECTALK_DEFAULT_SENDER_NUMBER=
DIRECTALK_ENV=production
DIRECTALK_TEMPLATE_PAID_CONFIRM=
DIRECTALK_TEMPLATE_PAID_INVITE=
# 테스트/프록시를 사용할 때만 덮어씁니다. 기본값: https://api.directalk.io/public/v1
DIRECTALK_API_BASE_URL=
