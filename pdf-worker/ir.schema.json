{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CourseDocumentPdfIR", "type": "object", "additionalProperties": false,
  "required": ["version", "title", "pageCount", "blocks", "outline"],
  "properties": {
    "version": {"const": 1}, "title": {"type": "string", "maxLength": 200},
    "pageCount": {"type": "integer", "minimum": 1, "maximum": 100},
    "outline": {"type": "array", "items": {"type": "object", "required": ["title", "level", "page", "blockId"], "properties": {"title": {"type": "string"}, "level": {"type": "integer", "minimum": 1, "maximum": 3}, "page": {"type": "integer", "minimum": 1}, "blockId": {"type": "string", "format": "uuid"}}}},
    "blocks": {"type": "array", "minItems": 1, "maxItems": 500, "items": {
      "type": "object", "required": ["id", "node", "source", "issues"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "node": {"$ref": "#/$defs/node"},
        "issues": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "object", "required": ["page", "bbox", "confidence", "method"], "properties": {
          "page": {"type": "integer", "minimum": 1, "maximum": 100},
          "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "method": {"enum": ["text", "ocr"]}
        }}
      }
    }}
  },
  "$defs": {"node": {"type": "object", "required": ["type"], "properties": {
    "type": {"enum": ["paragraph", "heading", "text", "hardBreak", "bulletList", "orderedList", "listItem", "table", "tableRow", "tableHeader", "tableCell", "image"]},
    "attrs": {"type": "object"}, "marks": {"type": "array", "maxItems": 20}, "text": {"type": "string", "maxLength": 200000}, "content": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/node"}}
  }}}
}
